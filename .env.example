# Copy this file to .env and fill in the values from the Supabase dashboard:
# Project Settings > API Keys (publishable key) and Data API (project URL).
# Both values are public by design; Row Level Security protects the data.
# Restart `npx expo start` after changing them.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
